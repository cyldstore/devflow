# 服务端口
PORT=3001

# mock | deepseek
LLM_PROVIDER=mock

# 只在 LLM_PROVIDER=deepseek 时需要
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# deepseek-chat | deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat

# hash | transformers
EMBEDDING_PROVIDER=hash

# 只在 EMBEDDING_PROVIDER=transformers 时使用
TRANSFORMERS_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2